<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android TV : pas besoin de tactile ni de caméra -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="true" />

    <!-- Build réservée aux appareils rootés : tous les accès fichiers passent par
         un shell root (su), qui contourne le stockage cloisonné sans qu'aucune
         permission de stockage (runtime ou MANAGE_EXTERNAL_STORAGE) soit requise. -->

    <application
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.TVCleanerBackup"
        tools:targetApi="34">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.TVCleanerBackup">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.RootToolsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.TVCleanerBackup" />
    </application>
</manifest>
